<dialog class="project-dialog" @ref="projectDialog" @onclose="DialogClosed" aria-labelledby="detail-title">
    <div class="dialog-shell">
        <div class="dialog-top"><span class="eyebrow">PROJECT</span><button class="dialog-close" @onclick="CloseProject" aria-label="Close project details">×</button></div>
        @if (activeProject is not null)
        {
            <div class="dialog-content">
                <div class="dialog-visual">
                    @if (CurrentImages.Count > 0)
                    {
                        <img src="@CurrentImages[slideIndex].Src" alt="@CurrentImages[slideIndex].Alt" />
                        @if (CurrentImages.Count > 1)
                        {
                            <button class="carousel-arrow previous" @onclick="PreviousSlide" aria-label="Previous project image">←</button>
                            <button class="carousel-arrow next" @onclick="NextSlide" aria-label="Next project image">→</button>
                            <div class="carousel-count" aria-live="polite">@(slideIndex + 1) / @CurrentImages.Count</div>
                        }
                    }
                    else
                    {
                        <div class="gallery-placeholder"><span class="placeholder-mark">{ ; }</span><b>Project visual</b></div>
                    }
                </div>
                <div class="dialog-copy">
                    <span class="project-type">@activeProject.Type</span><h2 id="detail-title">@activeProject.Title</h2><p>@activeProject.Description</p>
                    <div class="tag-row">
                        @foreach (var tag in activeProject.Tags.Split(','))
                        {
                            <span>@tag</span>
                        }
                    </div>
                    @if (activeProject.Link is not null)
                    {
                        <a class="button button-dark dialog-live-link" href="@activeProject.Link" target="_blank" rel="noopener noreferrer">Visit live app <span>↗</span></a>
                    }
                    @if (CurrentImages.Count > 1)
                    {
                        <div class="carousel-dots" aria-label="Choose project image">
                            @for (var i = 0; i < CurrentImages.Count; i++)
                            {
                                var index = i;
                                <button class="@(slideIndex == index ? "selected" : "")" aria-label="Show image @(index + 1)" aria-current="@(slideIndex == index ? "true" : null)" @onclick="() => ShowSlide(index)"></button>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</dialog>
@code {
    private bool menuOpen;
    private bool openPending;
    private ProjectCard? activeProject;
    private int slideIndex;
    private ElementReference projectDialog;
    private void ToggleMenu() => menuOpen = !menuOpen;
    private void CloseMenu() => menuOpen = false;
    private void OpenProject(ProjectCard project) { activeProject = project; slideIndex = 0; openPending = true; }
    private List<ProjectImage> CurrentImages => activeProject?.Title switch
    {
        "People, in one place." => [
            new("images/projects/hris/01-dashboard.png", "HRIS application dashboard screen"),
            new("images/projects/hris/02-announcements.png", "HRIS application announcements screen"),
            new("images/projects/hris/03-assets.png", "HRIS application assets screen")],
        "Consistency, connected." => [
            new("images/projects/master-data/01-login.gif", "Master Data application sign-in screen"),
            new("images/projects/master-data/02-articles.gif", "Master Data application articles screen"),
            new("images/projects/master-data/03-outlets.png", "Master Data application outlets screen")],
        "Requests, in motion." => [
            new("images/projects/request-monitoring/01-login.png", "Request Monitoring application sign-in screen"),
            new("images/projects/request-monitoring/02-login-light.png", "Request Monitoring application sign-in light screen"),
            new("images/projects/request-monitoring/03-user-guide.png", "Request Monitoring application user guide modal"),
            new("images/projects/request-monitoring/04-dashboard.png", "Request Monitoring application dashboard screen"),
            new("images/projects/request-monitoring/05-purchases.png", "Request Monitoring application purchase requests screen")],
        "SetTra Mobile App" => [
            new("images/projects/settra/02-update.png", "Settra invoices screen"),
            new("images/projects/settra/03-settings.png", "Settra settings screen"),
            new("images/projects/settra/04-invoices.png", "Settra invoices screen"),
            new("images/projects/settra/05-details.png", "Settra details screen"),
            new("images/projects/settra/06-remittance.png", "Settra remittance screen")],
        "INVENTOPRO: PicknPack" => [
            new("images/projects/inventopro-picknpack/01-login.png", "INVENTOPRO: PicknPack login screen"),
            new("images/projects/inventopro-picknpack/02-invoices.png", "INVENTOPRO: PicknPack invoices screen"),
            new("images/projects/inventopro-picknpack/03-details.png", "INVENTOPRO: PicknPack details screen"),
            new("images/projects/inventopro-picknpack/04-barcode-scanner.png", "INVENTOPRO: PicknPack barcode scanner screen")],
        "Gasta, made for mindful spending." => [
            new("images/projects/gasta/01-onboarding.png", "Gasta expense tracker onboarding screen"),
            new("images/projects/gasta/02-home.png", "Gasta expense tracker home screen"),
            new("images/projects/gasta/03-settings.png", "Gasta expense tracker settings screen")],
        _ => []
    };
    private void PreviousSlide() => slideIndex = (slideIndex - 1 + CurrentImages.Count) % CurrentImages.Count;
    private void NextSlide() => slideIndex = (slideIndex + 1) % CurrentImages.Count;
    private void ShowSlide(int index) => slideIndex = index;
    private async Task CloseProject() => await JS.InvokeVoidAsync("portfolio.closeDialog", projectDialog);
    private void DialogClosed() { activeProject = null; slideIndex = 0; openPending = false; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await JS.InvokeVoidAsync("portfolio.observeSections");
        if (openPending) { openPending = false; await JS.InvokeVoidAsync("portfolio.showDialog", projectDialog); }
    }
    private sealed record ProjectImage(string Src, string Alt);
}

